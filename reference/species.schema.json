{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/soheil-mp/wingbeat/reference/species.schema.json",
  "title": "Wingbeat species reference table",
  "description": "Literature-sourced wingbeat frequencies, temperature slopes and courtship convergence bands. Every value cites a source; unknown values stay unknown.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "table_version", "reference_temperature_c", "sources", "temperature_correction", "species"],
  "properties": {
    "schema_version": { "const": 1 },
    "table_version": {
      "description": "Semantic version of the table contents; recorded on every attributed event.",
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "reference_temperature_c": {
      "description": "Temperature every detection is normalised to (ADR-0009).",
      "type": "number"
    },
    "sources": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^[a-z]+\\d{4}[a-z]?$" },
      "additionalProperties": { "$ref": "#/$defs/source" }
    },
    "temperature_correction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["default"],
      "properties": { "default": { "$ref": "#/$defs/correction" } }
    },
    "species": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/species" }
    }
  },
  "$defs": {
    "source_key": { "type": "string", "pattern": "^[a-z]+\\d{4}[a-z]?$" },
    "locator": {
      "description": "Where in the source the value appears, e.g. 'Table 1' or 'Abstract'.",
      "type": "string",
      "minLength": 3
    },
    "sex": { "enum": ["female", "male"] },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["citation", "doi"],
      "properties": {
        "citation": { "type": "string", "minLength": 20 },
        "doi": { "type": "string", "pattern": "^10\\.\\d{4,9}/\\S+$" }
      }
    },
    "correction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "source", "locator", "quadratic", "linear", "reference_temperature_c", "valid_range_c"],
      "properties": {
        "method": {
          "description": "slope(f) = quadratic·f² + linear·f, in Hz/°C; f_ref = f + slope(f)·(T_ref − T).",
          "const": "frequency-dependent-slope"
        },
        "source": { "$ref": "#/$defs/source_key" },
        "locator": { "$ref": "#/$defs/locator" },
        "quadratic": { "type": "number" },
        "linear": { "type": "number" },
        "reference_temperature_c": { "type": "number" },
        "valid_range_c": {
          "type": "array",
          "prefixItems": [{ "type": "number" }, { "type": "number" }],
          "items": false,
          "minItems": 2
        }
      }
    },
    "measurement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sex", "mean_hz", "sd_hz", "n", "modality", "temperature_c", "temperature_basis", "condition", "source", "locator"],
      "properties": {
        "sex": { "$ref": "#/$defs/sex" },
        "mean_hz": { "type": "number", "minimum": 100, "maximum": 2000 },
        "sd_hz": { "type": ["number", "null"], "exclusiveMinimum": 0 },
        "n": {
          "description": "Sample size as reported; n_unit says what was counted.",
          "type": ["integer", "null"],
          "minimum": 1
        },
        "n_unit": { "enum": ["individuals", "recordings", "cages", "valid-files"] },
        "modality": { "enum": ["optical-infrared", "acoustic-microphone"] },
        "temperature_c": { "type": ["number", "null"] },
        "temperature_tolerance_c": { "type": ["number", "null"], "minimum": 0 },
        "temperature_basis": {
          "description": "recording: temperature during the recording; rearing: only the rearing or holding temperature is reported; unknown: not reported.",
          "enum": ["recording", "rearing", "unknown"]
        },
        "relative_humidity_pct": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
        "condition": {
          "description": "Physiological state and setup, as reported.",
          "type": "string",
          "minLength": 3
        },
        "source": { "$ref": "#/$defs/source_key" },
        "locator": { "$ref": "#/$defs/locator" },
        "note": { "type": "string" }
      }
    },
    "temperature_slope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sex", "min_hz_per_c", "max_hz_per_c", "source", "locator"],
      "properties": {
        "sex": { "$ref": "#/$defs/sex" },
        "min_hz_per_c": { "type": "number", "exclusiveMinimum": 0 },
        "max_hz_per_c": { "type": "number", "exclusiveMinimum": 0 },
        "source": { "$ref": "#/$defs/source_key" },
        "locator": { "$ref": "#/$defs/locator" }
      }
    },
    "convergence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["band_hz", "description", "source", "locator"],
      "properties": {
        "band_hz": {
          "type": "array",
          "prefixItems": [{ "type": "number" }, { "type": "number" }],
          "items": false,
          "minItems": 2
        },
        "description": { "type": "string", "minLength": 10 },
        "source": { "$ref": "#/$defs/source_key" },
        "locator": { "$ref": "#/$defs/locator" }
      }
    },
    "species": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "scientific_name", "gbif_taxon_key", "status", "measurements"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z]+-[a-z]+$" },
        "scientific_name": { "type": "string", "pattern": "^[A-Z][a-z]+ [a-z]+$" },
        "gbif_taxon_key": { "type": "integer", "minimum": 1 },
        "status": {
          "description": "measured: at least one cited measurement; unknown: no primary source found yet.",
          "enum": ["measured", "unknown"]
        },
        "measurements": { "type": "array", "items": { "$ref": "#/$defs/measurement" } },
        "temperature_slopes": { "type": "array", "items": { "$ref": "#/$defs/temperature_slope" } },
        "convergence": { "type": "array", "items": { "$ref": "#/$defs/convergence" } },
        "notes": { "type": "string" }
      }
    }
  }
}
