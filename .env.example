# Copy to .env and fill in for local development. Never commit .env.
# Every variable the code reads must be listed here with a placeholder value.

# --- Edge agent -------------------------------------------------------------
WINGBEAT_SENSOR_ID=sim-0001
WINGBEAT_SITE_ID=site-demo-01
WINGBEAT_AUDIO_SOURCE=simulator   # simulator | microphone | wav-dir | reference-replay
WINGBEAT_SAMPLE_RATE_HZ=8000

# --- MQTT (Eclipse Mosquitto) -----------------------------------------------
MQTT_HOST=localhost
MQTT_PORT=8883
MQTT_USERNAME=your-device-username
MQTT_PASSWORD=your-device-password
MQTT_CA_CERT_PATH=./deploy/compose/certs/ca.crt

# --- Kafka and schema registry ----------------------------------------------
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
SCHEMA_REGISTRY_URL=http://localhost:8081/apis/ccompat/v7

# --- Storage ----------------------------------------------------------------
S3_ENDPOINT_URL=http://localhost:8333
S3_ACCESS_KEY_ID=your-access-key-id
S3_SECRET_ACCESS_KEY=your-secret-access-key
POSTGRES_DSN=postgresql://wingbeat:your-password@localhost:5432/wingbeat
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_USER=wingbeat
CLICKHOUSE_PASSWORD=your-password

# --- API --------------------------------------------------------------------
# Only the write/admin endpoints need this token; read endpoints are public.
WINGBEAT_ADMIN_TOKEN=your-admin-token

# --- Observability ----------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=wingbeat-local
